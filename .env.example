# PostgreSQL
DATABASE_URL=postgresql://coexistencia:change-me@postgres:5432/coexistencia
# 64 hexadecimal characters. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Initial administrator. Used only by db:migrate; remove after bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Public URL, required for invitation links and Meta OAuth.
APP_URL=http://localhost:3000
# Meta Cloud API. Leave blank until the Meta app is ready.
FB_APP_ID=
FB_APP_SECRET=
FB_CONFIG_ID=
FB_GRAPH_API_VERSION=v22.0
FB_VERIFY_TOKEN=
FB_REG_PIN=
